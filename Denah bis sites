<script>
const KEY="denah-bis-v2",IK="denah-bis-img-v2";
const DEF={front:"data:image/jpeg;base64,",back:"data:image/jpeg;base64,",bg:"data:image/jpeg;base64,",bus:"data:image/jpeg;base64,"};
let data={},im={};
try{data=JSON.parse(localStorage.getItem(KEY)||"{}")}catch(e){}
try{im=JSON.parse(localStorage.getItem(IK)||"{}")}catch(e){}
const SEED={"s1": "dr. Imas Masturoh", "pa": "0.75", "f_tujuan": "EMTE HIGHLAND Ciwidey Bandung", "f_tanggal": "28-29 November 2026", "s2": "Ida Nurhosidah", "s3": "Hj. Euis", "s4": "dr. Reni", "s7": "Sri Suarti", "s8": "Amel", "s11": "Peni", "s12": "Dian", "s15": "Sari", "s16": "Annisa", "s19": "Ima", "s20": "Reta", "s23": "Ade S", "s24": "Sri Medan", "s27": "Himsanah", "s31": "Wa Karing", "s32": "", "s35": "Jundi", "s39": "dr algy", "s40": "sandi", "s44": "candra", "s50": "risma", "s5": "Leny", "s6": "Resa", "s9": "Cucu Gizi", "s10": "Nina", "s13": "Cucu Bdn", "s14": "Reni Bdn", "s17": "Sri W", "s18": "Dea", "s21": "Dewi", "s22": "Ruvi", "s26": "Siti Nurjanah", "s29": "Bayu", "s30": "Yudu", "s33": "", "s34": "Iman", "s37": "Dede Purdiana", "s41": "Asep TT", "s45": "Wa Molen", "s47": "Abah"};
if(!data.cleared&&!Object.keys(data).some(k=>k[0]==="s"&&String(data[k]).trim()))Object.assign(data,SEED);
const save=()=>{try{localStorage.setItem(KEY,JSON.stringify(data))}catch(e){}};
const saveImg=()=>{try{localStorage.setItem(IK,JSON.stringify(im))}catch(e){}};
const esc=s=>s.replace(/&/g,"&amp;").replace(/</g,"&lt;");
function seat(n){
 const v=data["s"+n]||"";
 return `<div class="seat"><svg viewBox="0 0 66 74" preserveAspectRatio="none"><use href="#jok"/></svg><b>${n}</b><textarea data-s="${n}" maxlength="36" aria-label="Nama kursi ${n}">${esc(v)}</textarea></div>`;
}
const pair=a=>`<div class="pair">${seat(a)}${seat(a+1)}</div>`;
let h="";
for(let r=0;r<10;r++){const l=r*4+1;h+=`<div class="row">${pair(l)}${pair(l+2)}</div>`}
h+=`<div class="door2"><span class="door">Pintu</span></div><div class="row">${pair(41)}${pair(43)}</div>`;
h+=`<div class="back">${[45,46,47,48,49,50].map(seat).join("")}</div>`;
document.getElementById("rows").innerHTML=h;
function count(){document.getElementById("count").textContent="Terisi: "+Object.keys(data).filter(k=>k[0]==="s"&&data[k].trim()).length+" dari 50 kursi"}
document.addEventListener("input",e=>{
 const t=e.target;
 if(t.dataset.s){t.value=t.value.replace(/\n/g," ");data["s"+t.dataset.s]=t.value}
 else if(t.dataset.k){data["f_"+t.dataset.k]=t.value}
 save();count();
});
document.querySelectorAll("[data-k]").forEach(i=>i.value=data["f_"+i.dataset.k]||"");
function resetAll(){
 if(!confirm("Kosongkan semua nama penumpang?"))return;
 Object.keys(data).forEach(k=>{if(k[0]==="s")delete data[k]});data.cleared=1;
 document.querySelectorAll("[data-s]").forEach(i=>i.value="");
 save();count();
}
function shrink(file,max,cb){
 const r=new FileReader();
 r.onload=()=>{const i=new Image();i.onload=()=>{const s=Math.min(1,max/Math.max(i.width,i.height)),c=document.createElement("canvas");c.width=i.width*s;c.height=i.height*s;c.getContext("2d").drawImage(i,0,0,c.width,c.height);cb(c.toDataURL("image/jpeg",.72))};i.src=r.result};
 r.readAsDataURL(file);
}
function applyImg(){
 const bg=document.getElementById("bg"),bus=document.getElementById("bus");
 bg.style.backgroundImage=`url(${im.bg||DEF.bg})`;bus.style.backgroundImage=`url(${im.bus||DEF.bus})`;document.getElementById('front').style.backgroundImage=`url(${DEF.front})`;document.getElementById('back').style.backgroundImage=`url(${DEF.back})`;
}
document.getElementById("fbg").onchange=e=>{const f=e.target.files[0];if(f)shrink(f,1400,u=>{im.bg=u;saveImg();applyImg()})};
document.getElementById("fbus").onchange=e=>{const f=e.target.files[0];if(f)shrink(f,1000,u=>{im.bus=u;saveImg();applyImg()})};
function resetImg(){im={};saveImg();applyImg()}
const pa=document.getElementById("pa"),setPa=v=>document.documentElement.style.setProperty("--pa",v);
pa.value=data.pa||.5;setPa(pa.value);
pa.oninput=()=>{setPa(pa.value);data.pa=pa.value;save()};
function setStatus(t){const e=document.getElementById("stat");e.textContent=t;clearTimeout(setStatus.t);setStatus.t=setTimeout(()=>e.textContent="",9000)}
function doPrint(){
 try{window.print()}catch(e){}
 if(window.self!==window.top)setStatus("Jika dialog cetak tidak muncul, cetak dari tab sendiri (tombol Buka versi penuh) atau tekan Ctrl+P.");
}
function simpan(){
 try{localStorage.setItem(KEY,JSON.stringify(data));setStatus(localStorage.getItem(KEY)?"Tersimpan di browser ini.":"Gagal menyimpan di browser ini. Pakai Simpan ke file atau Salin teks.")}
 catch(e){setStatus("Penyimpanan di browser ini diblokir. Pakai Simpan ke file atau Salin teks.")}
}
const eds=[...document.querySelectorAll("[data-ed]")];
function applyRd(){if(Array.isArray(data.rd)&&data.rd.length===eds.length)eds.forEach((e,i)=>e.textContent=data.rd[i])}
eds.forEach(e=>e.addEventListener("input",()=>{data.rd=eds.map(x=>x.textContent);save();if(typeof srvAuto==="function")srvAuto()}));
document.getElementById("prun").onchange=e=>document.body.classList.toggle("norun",!e.target.checked);
function applyData(){applyRd();
 document.querySelectorAll("[data-s]").forEach(i=>i.value=data["s"+i.dataset.s]||"");
 document.querySelectorAll("[data-k]").forEach(i=>i.value=data["f_"+i.dataset.k]||"");
 if(data.pa){pa.value=data.pa;setPa(data.pa)}
 count();
}
function load(txt){
 try{const o=JSON.parse(txt),d=o&&o.data?o.data:o;if(!d||typeof d!=="object")throw 0;
  Object.keys(data).forEach(k=>delete data[k]);Object.assign(data,d);delete data.cleared;save();applyData();return true}
 catch(e){alert("Data tidak bisa dibaca. Pastikan file atau teksnya utuh.");return false}
}
function saveFile(){
